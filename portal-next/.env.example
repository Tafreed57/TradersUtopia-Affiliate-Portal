# ============================================================================
# TradersUtopia Portal - Environment Configuration
# ============================================================================
# Copy this file to .env.local for local development
# Copy to .env.production for production (or set in Vercel dashboard)
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (Required)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# For Vercel Postgres: Copy from Vercel dashboard
# For local dev: Use local PostgreSQL or Docker
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Kj1hegNugawRiXDOxrahkOqzPey2nthpdtQHWyI5u5U"

# Optional: Direct connection for migrations (bypasses connection pooling)
DIRECT_URL="postgres://0edcc432af87428cc7f8e40502f117b48c36394b70986105627639d24cb2672c:sk_V75Nw5tTHvvCDS_saqtqr@db.prisma.io:5432/postgres?sslmode=require"

# ----------------------------------------------------------------------------
# AUTHENTICATION (Required)
# ----------------------------------------------------------------------------
# Secret for signing JWT tokens (generate with: openssl rand -base64 32)
JWT_SECRET="FPy7PWmq0bj95CKEqMNSatBCnkb9K6Iq/3nuFiSRJA0="

# Session duration in hours (default: 12)
SESSION_DURATION_HOURS=12

# Password hashing iterations (default: 10000, higher = slower but more secure)
PASSWORD_HASH_ITERATIONS=10000

# Rate limiting: max failed login attempts before lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Rate limiting: lockout duration in minutes
LOCKOUT_DURATION_MINUTES=15

# ----------------------------------------------------------------------------
# REWARDFUL API (Required for commission features)
# ----------------------------------------------------------------------------
# Get from: https://app.getrewardful.com/settings/api
REWARDFUL_API_KEY=a19ffe31b1e28e95f16637992bb6f67a

# API base URL (usually don't change this)
REWARDFUL_API_BASE_URL="https://api.getrewardful.com/v1"

# ----------------------------------------------------------------------------
# ADMIN CONFIGURATION (Required)
# ----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Comma-separated list of teacher override emails (non-teachers with teacher access)
TEACHER_OVERRIDE_EMAILS="override@example.com"

# ----------------------------------------------------------------------------
# CURRENCY CONVERSION (Optional)
# ----------------------------------------------------------------------------
# USD to CAD conversion rate (default: 1.4)
USD_TO_CAD_RATE=1.39

# ----------------------------------------------------------------------------
# CACHING (Optional)
# ----------------------------------------------------------------------------
# Session cache TTL in seconds (default: 45000 = 12.5 hours)
SESSION_CACHE_TTL_SECONDS=45000

# API response cache TTL in seconds (default: 300 = 5 minutes)
API_CACHE_TTL_SECONDS=300

# Referral/leads cache TTL in seconds (default: 900 = 15 minutes)
REFERRAL_CACHE_TTL_SECONDS=900

# ----------------------------------------------------------------------------
# LOGGING (Optional)
# ----------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Enable structured JSON logging (recommended for production)
LOG_JSON="false"

# ----------------------------------------------------------------------------
# NEXT.JS (Optional)
# ----------------------------------------------------------------------------
# Base URL for the application (used for redirects, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App name displayed in UI
NEXT_PUBLIC_APP_NAME="TradersUtopia Portal"

# ----------------------------------------------------------------------------
# LEGACY MIGRATION (Temporary - remove after migration)
# ----------------------------------------------------------------------------
# Enable compatibility API endpoint (/api/gs-call)
ENABLE_LEGACY_COMPAT_API="true"

# Legacy GAS web app URL (for gradual migration)
LEGACY_GAS_URL=""
